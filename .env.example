# ========= OneBot / NoneBot =========
# NoneBot 驱动：FastAPI（提供反向 WebSocket 服务端）
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
# OneBot 11 access token，必须与 NapCat 侧配置的完全一致
ONEBOT_ACCESS_TOKEN=your-onebot-token

# ========= LLM（任何 OpenAI Compatible API）=========
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key
LLM_MODEL=glm-4-flash
LLM_TIMEOUT=60
# 采样温度（越高越随机，默认 0.9；技术问答会自动略降）
LLM_TEMPERATURE=0.9
# 不调用 LLM 的交互回复动态延迟：最小秒数、最大秒数、每秒处理字符数
NON_LLM_REPLY_DELAY_MIN_SECONDS=2
NON_LLM_REPLY_DELAY_MAX_SECONDS=6
NON_LLM_REPLY_DELAY_CHARS_PER_SECOND=35
# 旧配置 NON_LLM_REPLY_DELAY_SECONDS 仍兼容，会覆盖最大延迟；设为 0 关闭

# ========= 人格 =========
# YAML 人格配置路径；相对路径以项目根目录为准
PERSONALITY_FILE=rumi_helper/personality/rumi.yaml
# 主人真实 QQ 号；优先使用此项。留空且只有一个 ADMIN_QQ_IDS 时兼容性回退到该管理员
OWNER_QQ_ID=
# 主人的称呼（关系注入使用，默认 Parrotools）
OWNER_NAME=Parrotools

# ========= 会话 =========
# 上下文最大历史消息条数（user+assistant 合计）
MAX_CONTEXT_MESSAGES=20
# 送入 LLM 的历史上下文总字符预算；单条持久化消息也不会超过此值
MAX_CONTEXT_CHARS=16000
# 群聊是否全员共享同一个上下文（默认 false：群内每个成员独立上下文）
GROUP_SHARED_CONTEXT=false

# ========= 网页 =========
# off: 不自动读取 URL | mentioned: 仅被@/私聊/明确命令时读取 | all: 检测到 URL 就处理
URL_AUTO_SUMMARY_MODE=mentioned
# 单页最大下载字节数（默认 4MB）
MAX_WEBPAGE_BYTES=4194304
WEB_FETCH_TIMEOUT_CONNECT=10
WEB_FETCH_TIMEOUT_READ=30
# 如需网页抓取代理，只支持 SOCKS5；例如 Clash 常用 socks5://127.0.0.1:7897
# 不读取 HTTP_PROXY/HTTPS_PROXY，避免破坏 SSRF 的 IP pinning + 原域名 TLS SNI。
WEB_PROXY_URL=
WEB_SUMMARY_CHUNK_CHARS=4000
WEB_SUMMARY_MAX_CHUNKS=8
# 同一 URL 抓取结果缓存秒数（0 = 关闭缓存）
WEB_CACHE_TTL_SECONDS=600
# 普通抓取无正文时是否允许 Playwright fallback（需自行 pip install .[playwright]）
ENABLE_PLAYWRIGHT=false

# ========= 权限与群发 =========
# 管理员 QQ 号，逗号分隔
ADMIN_QQ_IDS=123456789
MAX_BROADCAST_RECIPIENTS=20
# 所有主动发送（direct/broadcast/持久队列）在共享同一 SQLite 数据库的进程间统一限速
SEND_RATE_LIMIT_PER_SECOND=1
# 所有交互回复共用的发送速率；0.5 = 平均每 2 秒最多 1 条
INTERACTIVE_SEND_RATE_LIMIT_PER_SECOND=0.5
# 主动通知投递：失败后写入 SQLite 队列并重试
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_DELAY_SECONDS=30
# 账号掉线/接口限流时暂停主动投递，避免反复请求
OUTBOUND_ACCOUNT_PAUSE_SECONDS=1800
OUTBOUND_RATE_LIMIT_PAUSE_SECONDS=60
OUTBOUND_QUEUE_POLL_SECONDS=1
OUTBOUND_LEASE_SECONDS=60
# 仅保留最近的终态主动消息/发送审计元数据；0 表示不保留终态历史
OUTBOUND_TERMINAL_HISTORY_LIMIT=5000
SEND_LOG_HISTORY_LIMIT=5000
BROADCAST_REQUIRE_CONFIRM=true
BROADCAST_CONFIRM_TTL_SECONDS=300

# ========= 并发 =========
MAX_CONCURRENT_WEB_TASKS=3
MAX_CONCURRENT_LLM_TASKS=5

# 自然语言工具调用：例如“把 OpenAI/openai-python 加入我的 GitHub 列表”
AGENT_TOOL_CALLING_ENABLED=true
AGENT_CONFIRM_TTL_SECONDS=300

# ========= 定时任务 =========
SCHEDULER_TIMEZONE=Asia/Shanghai
# 每用户最多同时存在的 active reminder 数量
MAX_ACTIVE_REMINDERS_PER_USER=50
# 仅保留最近的 disabled/终态定时任务；active 任务永不清理，0 表示不保留终态历史
SCHEDULED_TASK_HISTORY_LIMIT=5000
# 每用户最多监控的 GitHub 仓库数量
MAX_GITHUB_REPOSITORIES_PER_USER=50
# GitHub API token（可选；提高 API 速率上限）
GITHUB_TOKEN=
# GitHub 仓库轮询频率，5 段 cron；留空关闭自动检查
GITHUB_CHECK_CRON=0 * * * *
# GitHub 仓库汇总发送时间；上海时间每天 06:00 和 18:00
GITHUB_DIGEST_CRON=0 6,18 * * *
# 日报发送时间，5 段 cron；留空关闭自动日报
DAILY_REPORT_CRON=0 23 * * *

# ========= 数据 =========
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
